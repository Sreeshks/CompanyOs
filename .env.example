# Application Configuration
APP_NAME="Company OS"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-with-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/company_os
# For local dev / SQLite: sqlite:///./company_os.db
DATABASE_URL="sqlite:///./company_os.db"

# Admin Initial Setup (Used by seeding script)
FIRST_SUPERUSER_EMAIL="admin@companyos.local"
FIRST_SUPERUSER_PASSWORD="AdminSecurePassword123!"
FIRST_SUPERUSER_NAME="Super Administrator"

# CORS
CORS_ORIGINS=["*"]
